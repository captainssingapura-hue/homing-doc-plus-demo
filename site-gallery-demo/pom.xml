<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
        <artifactId>homing-doc-plus-demo</artifactId>
        <version>VOID-SNAPSHOT</version>
    </parent>
    <artifactId>site-gallery-demo</artifactId>
    <description>
        RFC 0066 Episode 3 - the gallery: JS apps served as pages under the
        standard MPA, wearing the seven studio designs - the components, each on a
        page of its own, and the tour that shows every one beside what it explains.
        Its tree is written alone, a catalogue per group, and knows no site: the
        demo site grafts it at /gallery and serves it. Here so that it can host
        components from other repos - the relation grid and its tree - without
        the core depending on them.
    </description>
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The gallery's tree: a catalogue per group, which a site grafts. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-catalogue</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- What the tree and the plain page are made of: a navigable, a page's content, a node's name. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-rigid-tree</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The MPA's implementation - StandardMpa, its page, its chrome - from the
             ui-components repo; core's homing-site-mpa above holds the definitions. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-elements</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-dialog</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-preferences</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-panes</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-floating</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-docking</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-splitgrid</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-menu</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-focus</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-component-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The designs the gallery wears - the framework's, nothing legacy - which its tests hold
             every sheet to; the site that serves it brings its own. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-designs</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The relation grid and its tree, from their own repo: layer-2 components
             on core and design-core alone; the page hands each a branch and a
             relation. The protocol is named for the tree's questions. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-grid</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-tree</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-grid-protocol</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
