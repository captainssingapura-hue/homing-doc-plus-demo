<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
        <artifactId>homing-doc-plus-demo</artifactId>
        <version>VOID-SNAPSHOT</version>
    </parent>

    <artifactId>mermaid-mirror-demo</artifactId>

    <description>
        End-to-end demo of running a Mermaid-enabled site against a self-hosted
        "manual CDN" instead of the public one:

          • MermaidStudioServer (port 8108) — a tiny catalogue site with one Mermaid doc,
            read in DocView, whose MermaidProxyModule URL is OVERRIDDEN to the local CDN below.
          • LocalCdnServer (port 8109) — serves ./mirror/ over HTTP with the CORS
            headers a cross-origin ES-module import needs.
          • MermaidDownloader — mirrors Mermaid (entry + transitive chunks) from
            jsDelivr into ./mirror/ so the local CDN has something to serve.

        See README.md for the run order and a manual-download fallback.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- The doc, and Mermaid's proxy with the override table it reads its address from. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-doc-model</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-libs</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The site: the catalogue site, DocView, and the standard MPA it is served through. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-catalogue-site</artifactId>
            <version>${homing.studio.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-app</artifactId>
            <version>${homing.studio.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
            <artifactId>homing-docview-site</artifactId>
            <version>${homing.studio.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <!-- The site's own substrate: the catalogue its tree is, the page and the MPA, a node's name, the designs. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-catalogue</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-rigid-tree</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-designs</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-server</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.studio</groupId>
