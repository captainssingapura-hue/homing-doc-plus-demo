<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
    <artifactId>homing-doc-plus-demo</artifactId>
    <version>VOID-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <!-- RFC 0066 - the bare app: served and themed with no studio on the classpath. -->
        <module>bare-app-demo</module>
        <!-- RFC 0066 E3 - the gallery: JS apps under the standard MPA, and the
             relation grid and its tree as pages beside them. Its tree is grafted
             into the demo site, which serves it. -->
        <module>site-gallery-demo</module>
        <module>mermaid-mirror-demo</module>
        <module>doc-pdf-export</module>
        <!-- The demo's widgets ported to the workspace on its core (the homing-ssjs-workspace
             repo), and its workspaces declared - linked to that workspace alone, never to the
             studio's old one. The demo site serves them. -->
        <module>homing-demo-workspace-widgets</module>
        <module>homing-demo-workspace</module>
        <!-- The demo's front door: a catalogue site, its docs read in DocView, its workspaces opened beside. -->
        <!-- RFC 0067: the house's taxonomy of components, in a workbench beside the gallery; the
             house's components in action, each a small widget of its own, controlled by its options. -->
        <module>homing-demo-components</module>
        <module>homing-demo-taxonomy</module>
        <module>homing-demo-site</module>
        <!-- The demo's conformance: every crate it serves, graded by the framework's policy extended
             with the widgets' game-loop rule set; and its studio, the studio repo's workbench, on 8091. -->
        <module>homing-demo-conformance</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <homing.core.version>LOCAL-SNAPSHOT</homing.core.version>
        <!-- The ui-components (and the MPA's standard implementation), from the
             homing-ssjs-ui-components repo: moved out of core, same coordinates,
             their own version. -->
        <homing.components.version>LOCAL-SNAPSHOT</homing.components.version>
        <homing.relgrid.version>LOCAL-SNAPSHOT</homing.relgrid.version>
        <!-- The workspace on its headless core, from the homing-ssjs-workspace repo. -->
        <homing.ws.version>LOCAL-SNAPSHOT</homing.ws.version>
        <!-- The site the docs are read on: the catalogue site and DocView, from the homing-ssjs-studio repo. -->
        <homing.studio.version>LOCAL-SNAPSHOT</homing.studio.version>
        <junit.version>5.11.3</junit.version>
        <jacoco.version>0.8.14</jacoco.version>
    </properties>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
